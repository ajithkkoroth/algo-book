    "<script>\n",
    "// ==========================================================\n",
    "// 1. QUESTION BANKS (Auto-scales when you append items!)\n",
    "// ==========================================================\n",
    "const mcqData = [\n",
    "  {\n",
    "    title: \"1. Problem-Solving Strategies\",\n",
    "    prompt: \"You lose your hostel keys. Instead of searching every inch of campus, you check the canteen table and your pocket first. Which strategy is this?\",\n",
    "    code: \"\",\n",
    "    options: [\"Trial and Error\", \"Heuristics (Rule of Thumb)\", \"Working Backward\", \"Problem Decomposition\"],\n",
    "    b64_correct: \"SGV1cmlzdGljcyAoUnVsZSBvZiBUaHVtYik=\",\n",
    "    feedback: {\n",
    "      \"Trial and Error\": \"Not quite! Trial and Error checks every possible spot without an educated guess.\",\n",
    "      \"Heuristics (Rule of Thumb)\": \"Correct! Using past experience to check the most likely places first is a Heuristic.\",\n",
    "      \"Working Backward\": \"Not quite! Working backward starts from the end goal (like an exam time) and subtracts.\",\n",
    "      \"Problem Decomposition\": \"Not quite! Decomposition breaks a massive problem into smaller sub-problems.\"\n",
    "    }\n",
    "  },\n",
    "  {\n",
    "    title: \"2. The Text-to-Math Trap\",\n",
    "    prompt: \"What gets printed when Python runs these two lines?\",\n",
    "    code: 'price = \"45\"\\nprint(price + \"5\")',\n",
    "    options: [\"50\", \"455\", \"price + 5\", \"TypeError\"],\n",
    "    b64_correct: \"NDU1\",\n",
    "    feedback: {\n",
    "      \"50\": \"Careful! Look at the quotes around '45' and '5'. Python treats them as Strings (text), not numbers.\",\n",
    "      \"455\": \"Spot on! Because both are Strings inside quotes, the + operator glues them side-by-side into '455'.\",\n",
    "      \"price + 5\": \"price is not inside quotes in print(), so Python looks inside the price box.\",\n",
    "      \"TypeError\": \"Gluing two Strings together with + is completely legal in Python.\"\n",
    "    }\n",
    "  },\n",
    "  {\n",
    "    title: \"3. Floor Division vs. Modulo\",\n",
    "    prompt: \"You divide 17 samosas equally among 5 friends. Which expression gives the LEFT OVER samosas?\",\n",
    "    code: \"\",\n",
    "    options: [\"17 / 5\", \"17 // 5\", \"17 % 5\", \"17 ** 5\"],\n",
    "    b64_correct: \"MTcgJSA1\",\n",
    "    feedback: {\n",
    "      \"17 / 5\": \"17 / 5 gives 3.4 (decimal division).\",\n",
    "      \"17 // 5\": \"Floor division (//) gives 3 (how many each friend eats, not what is left over).\",\n",
    "      \"17 % 5\": \"Correct! Modulo (%) gives the remainder of division: 17 % 5 = 2 leftover samosas.\",\n",
    "      \"17 ** 5\": \"** calculates 17 to the power of 5!\"\n",
    "    }\n",
    "  },\n",
    "  {\n",
    "    title: \"4. Operator Precedence (BODMAS)\",\n",
    "    prompt: \"Act as the computer. What exact number is stored in result?\",\n",
    "    code: \"result = 10 - 2 * 3 ** 2\",\n",
    "    options: [\"64\", \"72\", \"-8\", \"-26\"],\n",
    "    b64_correct: \"LTg=\",\n",
    "    feedback: {\n",
    "      \"64\": \"Remember BODMAS! Do not subtract 10 - 2 first.\",\n",
    "      \"72\": \"Python calculates 3 ** 2 (9) first, then 2 * 9 (18), then 10 - 18.\",\n",
    "      \"-8\": \"Correct! Step 1: 3 ** 2 = 9. Step 2: 2 * 9 = 18. Step 3: 10 - 18 = -8.\",\n",
    "      \"-26\": \"2 * 3 ** 2 squares only the 3, not (2 * 3).\"\n",
    "    }\n",
    "  },\n",
    "  {\n",
    "    title: \"5. The Logic Gates\",\n",
    "    prompt: \"Trace the bouncers! What does the final line print?\",\n",
    "    code: \"has_id = True\\npaid_fee = False\\nprint(has_id and not paid_fee)\",\n",
    "    options: [\"True\", \"False\", \"None\", \"SyntaxError\"],\n",
    "    b64_correct: \"VHJ1ZQ==\",\n",
    "    feedback: {\n",
    "      \"True\": \"Correct! Since paid_fee is False, 'not paid_fee' flips it to True. Then 'True and True' is True!\",\n",
    "      \"False\": \"Look closely at the 'not' operator! paid_fee is False, so 'not paid_fee' flips to True.\",\n",
    "      \"None\": \"Logical operators always evaluate to True or False, never None.\",\n",
    "      \"SyntaxError\": \"Combining 'and' with 'not' is completely valid Python syntax.\"\n",
    "    }\n",
    "  }\n",
    "];\n",
    "\n",
    "const pseudoTasks = [\n",
    "  {\n",
    "    title: \"1. Area of a Circle (AI Checkpoint 1.1)\",\n",
    "    prompt: \"Write a 4-step pseudocode algorithm to READ radius, COMPUTE area = 3.14159 * radius * radius, and PRINT area. (Include START and STOP!)\",\n",
    "    b64_model: \"U1RBUlQKUkVBRCBSYWRpdXMKQ09NUFVURSBhcmVhID0gMy4xNDE1OSAqIFJhZGl1cyAqIFJhZGl1cwpQUklOVCBhcmVhClNUT1A=\",\n",
    "    flow: [[\"oval\", \"START\"], [\"io\", \"READ radius\"], [\"proc\", \"COMPUTE area = 3.14159 * radius * radius\"], [\"io\", \"PRINT area\"], [\"oval\", \"STOP\"]]\n",
    "  },\n",
    "  {\n",
    "    title: \"2. Weeks & Leftover Days (Level 3 Mission)\",\n",
    "    prompt: \"Write pseudocode to READ total_days, compute full weeks using // 7, compute leftover days using % 7, and PRINT both.\",\n",
    "    b64_model: \"U1RBUlQKUkVBRCB0b3RhbF9kYXlzCkNPTVBVVEUgd2Vla3MgPSB0b3RhbF9kYXlzIC8vIDcKQ09NUFVURSBsZWZ0b3ZlciA9IHRvdGFsX2RheXMgJSA3ClBSSU5UIHdlZWtzLCBsZWZ0b3ZlcgpTVE9Q\",\n",
    "    flow: [[\"oval\", \"START\"], [\"io\", \"READ total_days\"], [\"proc\", \"COMPUTE weeks = total_days // 7\"], [\"proc\", \"COMPUTE leftover = total_days % 7\"], [\"io\", \"PRINT weeks, leftover\"], [\"oval\", \"STOP\"]]\n",
    "  },\n",
    "  {\n",
    "    title: \"3. Hostel Currency Converter (INR to USD)\",\n",
    "    prompt: \"Write pseudocode to READ amount_inr, COMPUTE amount_usd = amount_inr / 83, and PRINT amount_usd.\",\n",
    "    b64_model: \"U1RBUlQKUkVBRCBhbW91bnRfaW5yCkNPTVBVVEUgYW1vdW50X3VzZCA9IGFtb3VudF9pbnIgLyA4MwpQUklOVCBhbW91bnRfdXNkClNUT1A=\",\n",
    "    flow: [[\"oval\", \"START\"], [\"io\", \"READ amount_inr\"], [\"proc\", \"COMPUTE amount_usd = amount_inr / 83\"], [\"io\", \"PRINT amount_usd\"], [\"oval\", \"STOP\"]]\n",
    "  }\n",
    "];\n",
    "\n",
    "const pyMissions = [\n",
    "  {\n",
    "    title: \"Mission 1: Fix the Text-to-Math Trap\",\n",
    "    prompt: \"Wrap <code>input()</code> inside <code>int()</code> on line 1 so all 3 test cases pass.\",\n",
    "    starter: 'price = input(\"Enter item price: \")\\ntax = 5\\nfinal_bill = price + tax\\nprint(final_bill)',\n",
    "    hint: \"Change line 1 to: <code>price = int(input(\\\"Enter item price: \\\"))</code>\",\n",
    "    pyRunner: `\n",
    "test_cases = [(1, '100', '105', 105, 'Standard integer input'), (2, '45', '50', 50, 'Odd number price check'), (3, '0', '5', 5, 'Zero-rupee edge case')]\n",
    "rows, passed_count = [], 0\n",
    "for num, tin, exp_str, exp_val, desc in test_cases:\n",
    "    ns = {'input': lambda p='': tin}\n",
    "    out = []\n",
    "    ns['print'] = lambda *a: out.append(' '.join(str(x) for x in a))\n",
    "    try:\n",
    "        exec(_student_code, ns)\n",
    "        actual = out[-1].strip() if out else 'Nothing'\n",
    "        passed = (actual == exp_str and ns.get('final_bill') == exp_val)\n",
    "        comment = desc if passed else 'Use int(input())'\n",
    "    except TypeError:\n",
    "        actual, passed, comment = 'TypeError', False, 'Wrap input() in int()'\n",
    "    except Exception as e:\n",
    "        actual, passed, comment = type(e).__name__, False, str(e)\n",
    "    if passed: passed_count += 1\n",
    "    rows.append((num, tin, exp_str, actual, passed, comment))\n",
    "_res = (passed_count, rows)\n",
    "`\n",
    "  },\n",
    "  {\n",
    "    title: \"Mission 2: The Week & Day Splitter\",\n",
    "    prompt: \"Calculate full 7-day <code>weeks</code> using <code>// 7</code> and <code>leftover</code> days using <code>% 7</code>.\",\n",
    "    starter: 'days = int(input(\"Enter days: \"))\\nweeks = \\nleftover = \\nprint(weeks, leftover)',\n",
    "    hint: \"Set <code>weeks = days // 7</code> and <code>leftover = days % 7</code>.\",\n",
    "    pyRunner: `\n",
    "test_cases = [(1, '10', '1 3', 1, 3, '10 days = 1w, 3d'), (2, '28', '4 0', 4, 0, 'Exact multiple of 7'), (3, '5', '0 5', 0, 5, 'Less than 1 week')]\n",
    "rows, passed_count = [], 0\n",
    "for num, tin, exp_str, ew, el, desc in test_cases:\n",
    "    ns = {'input': lambda p='': tin}\n",
    "    out = []\n",
    "    ns['print'] = lambda *a: out.append(' '.join(str(x) for x in a))\n",
    "    try:\n",
    "        exec(_student_code, ns)\n",
    "        actual = out[-1].strip() if out else 'Nothing'\n",
    "        if isinstance(ns.get('weeks'), float):\n",
    "            passed, comment = False, 'Use // instead of /'\n",
    "        else:\n",
    "            passed = (ns.get('weeks') == ew and ns.get('leftover') == el and actual == exp_str)\n",
    "            comment = desc if passed else f'Exp: {ew} and {el}'\n",
    "    except Exception as e:\n",
    "        actual, passed, comment = type(e).__name__, False, str(e)\n",
    "    if passed: passed_count += 1\n",
    "    rows.append((num, tin, exp_str, actual, passed, comment))\n",
    "_res = (passed_count, rows)\n",
    "`\n",
    "  },\n",
    "  {\n",
    "    title: \"Mission 3: Exact Circle Area Calculator\",\n",
    "    prompt: \"Import <code>math</code> at the top and calculate <code>area = math.pi * (radius ** 2)</code>.\",\n",
    "    starter: '# Step 1: Import math\\n\\nradius = float(input(\"Enter radius: \"))\\narea = \\nprint(area)',\n",
    "    hint: \"Write <code>import math</code> on line 1, and <code>area = math.pi * (radius ** 2)</code>.\",\n",
    "    pyRunner: `\n",
    "import math as _m\n",
    "test_cases = [(1, '5', '78.5398', 78.53981633974483, 'Integer radius (r=5)'), (2, '2.5', '19.6350', 19.634954084936208, 'Float radius (r=2.5)'), (3, '0', '0.0000', 0.0, 'Zero radius (r=0)')]\n",
    "rows, passed_count = [], 0\n",
    "for num, tin, exp_disp, exp_val, desc in test_cases:\n",
    "    ns = {'input': lambda p='': tin}\n",
    "    out = []\n",
    "    ns['print'] = lambda *a: out.append(' '.join(str(x) for x in a))\n",
    "    if 'import math' not in _student_code or 'math.pi' not in _student_code:\n",
    "        rows.append((num, tin, exp_disp, 'No math.pi', False, 'Use import math & math.pi'))\n",
    "        continue\n",
    "    try:\n",
    "        exec(_student_code, ns)\n",
    "        area_val = ns.get('area')\n",
    "        actual = f'{area_val:.4f}' if isinstance(area_val, (int, float)) else 'Missing'\n",
    "        passed = isinstance(area_val, (int, float)) and abs(area_val - exp_val) < 0.001\n",
    "        comment = desc if passed else 'Use math.pi * (radius ** 2)'\n",
    "    except Exception as e:\n",
    "        actual, passed, comment = type(e).__name__, False, str(e)\n",
    "    if passed: passed_count += 1\n",
    "    rows.append((num, tin, exp_disp, actual, passed, comment))\n",
    "_res = (passed_count, rows)\n",
    "`\n",
    "  }\n",
    "];\n",
    "\n",
    "// ==========================================================\n",
    "// 2. STATE & INSTANT RENDER ENGINE\n",
    "// ==========================================================\n",
    "const NUM_MCQ = mcqData.length;\n",
    "const NUM_PSEUDO = pseudoTasks.length;\n",
    "const NUM_PY = pyM
